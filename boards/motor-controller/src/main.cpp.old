// motor_main.cpp
// Main program for Motor Controller Board
// Sends: Motor telemetry (RPM, current, temperature, status)
// Receives: Throttle commands from Throttle board

#define MC_BOARD  // Motor Controller board

#include <Arduino.h>
#include "../../Comms/CAN Network/vehicle.hpp"
